/* ================================================
   Bloom & Petal — styles.css
   Luxury Floral Website Stylesheet
   ================================================ */

/* ─── CSS Variables ─────────────────────────── */
:root {
  --cream:    #faf6f0;
  --ivory:    #f5ede0;
  --blush:    #f2c4c4;
  --rose:     #d4768a;
  --deep-rose:#a64060;
  --green:    #4a6741;
  --sage:     #8aab7e;
  --gold:     #c9a87c;
  --dark:     #1e1a18;
  --charcoal: #2e2926;
  --mid:      #6b5e57;
  --light:    #9e9089;

  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-sans:  'Jost', sans-serif;

  --radius: 16px;
  --radius-sm: 8px;
  --shadow: 0 8px 40px rgba(30, 26, 24, 0.12);
  --shadow-lg: 0 24px 80px rgba(30, 26, 24, 0.2);
  --transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ─── Reset & Base ──────────────────────────── */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: var(--font-sans);
  background: var(--cream);
  color: var(--charcoal);
  overflow-x: hidden;
  cursor: none;
}

img { display: block; width: 100%; height: 100%; object-fit: cover; }

a { text-decoration: none; color: inherit; }

ul { list-style: none; }

p { line-height: 1.75; color: var(--mid); }

/* ─── Custom Cursor ─────────────────────────── */
.cursor {
  position: fixed;
  width: 40px; height: 40px;
  border: 1.5px solid var(--rose);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s, background 0.3s, border-color 0.3s;
}
.cursor.hover { width: 64px; height: 64px; background: rgba(212, 118, 138, 0.12); }
.cursor-dot {
  position: fixed;
  width: 6px; height: 6px;
  background: var(--rose);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
}

/* ─── Loader ────────────────────────────────── */
.loader {
  position: fixed; inset: 0;
  background: var(--dark);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  z-index: 9000;
  transition: opacity 0.6s, visibility 0.6s;
}
.loader.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.loader-flower {
  font-size: 4rem;
  color: var(--rose);
  animation: spinBloom 1.5s ease-in-out infinite;
}
@keyframes spinBloom {
  0%, 100% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(180deg) scale(1.3); }
}
.loader-text {
  font-family: var(--font-serif);
  font-size: 1.8rem;
  color: var(--ivory);
  margin-top: 1rem;
  letter-spacing: 0.3em;
  opacity: 0.7;
}

/* ─── Navigation ────────────────────────────── */
.nav {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 1000;
  display: flex; align-items: center;
  padding: 1.5rem 4rem;
  transition: background 0.4s, padding 0.4s, box-shadow 0.4s;
}
.nav.scrolled {
  background: rgba(250, 246, 240, 0.95);
  backdrop-filter: blur(12px);
  padding: 1rem 4rem;
  box-shadow: 0 2px 20px rgba(30,26,24,0.08);
}
.nav-logo {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--dark);
  letter-spacing: 0.05em;
  margin-right: auto;
}
.nav-links {
  display: flex; gap: 2.5rem;
  margin-right: 2.5rem;
}
.nav-links a {
  font-size: 0.8rem;
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--charcoal);
  position: relative;
  transition: color 0.3s;
}
.nav-links a::after {
  content: '';
  position: absolute; left: 0; bottom: -4px;
  width: 0; height: 1px;
  background: var(--rose);
  transition: width 0.3s;
}
.nav-links a:hover { color: var(--rose); }
.nav-links a:hover::after { width: 100%; }
.nav-cta {
  background: var(--rose);
  color: #fff;
  border: none;
  padding: 0.6rem 1.4rem;
  border-radius: 100px;
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s;
}
.nav-cta:hover { background: var(--deep-rose); transform: scale(1.05); }
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.hamburger span {
  display: block;
  width: 24px; height: 1.5px;
  background: var(--dark);
  transition: 0.3s;
}

/* Mobile Menu */
.mobile-menu {
  position: fixed; top: 0; right: -100%;
  width: 280px; height: 100vh;
  background: var(--dark);
  z-index: 999;
  display: flex; flex-direction: column;
  padding: 6rem 2.5rem 2.5rem;
  gap: 2rem;
  transition: right 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.mobile-menu.open { right: 0; }
.mobile-menu a {
  font-family: var(--font-serif);
  font-size: 2rem;
  color: var(--ivory);
  transition: color 0.3s;
}
.mobile-menu a:hover { color: var(--rose); }

/* ─── Hero ──────────────────────────────────── */
.hero {
  position: relative;
  height: 100vh; min-height: 680px;
  display: flex; align-items: center;
  overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; }
.hero-img { width: 100%; height: 100%; object-fit: cover; }
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(120deg, rgba(30,26,24,0.6) 30%, rgba(30,26,24,0.2) 100%);
}
.hero-content {
  position: relative;
  z-index: 2;
  padding: 0 4rem;
  max-width: 720px;
  animation: fadeUp 1.2s 2s both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(40px); }
  to { opacity: 1; transform: translateY(0); }
}
.hero-sub {
  font-size: 0.72rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 1.2rem;
}
.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(3.5rem, 7vw, 6.5rem);
  font-weight: 300;
  line-height: 1.05;
  color: #fff;
  margin-bottom: 1.5rem;
}
.hero-title em {
  font-style: italic;
  color: var(--blush);
}
.hero-desc {
  font-size: 1rem;
  color: rgba(255,255,255,0.75);
  margin-bottom: 2.5rem;
  max-width: 440px;
}
.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
.btn-primary {
  background: var(--rose);
  color: #fff;
  border: none;
  padding: 0.9rem 2rem;
  border-radius: 100px;
  font-family: var(--font-sans);
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
}
.btn-primary:hover { background: var(--deep-rose); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(166,64,96,0.35); }
.btn-primary.full { width: 100%; padding: 1rem; font-size: 0.9rem; margin-top: 0.5rem; border-radius: var(--radius-sm); }
.btn-ghost {
  background: transparent;
  color: rgba(255,255,255,0.9);
  border: 1px solid rgba(255,255,255,0.4);
  padding: 0.9rem 2rem;
  border-radius: 100px;
  font-family: var(--font-sans);
  font-size: 0.85rem;
  font-weight: 400;
  cursor: pointer;
  transition: background 0.3s, border-color 0.3s;
}
.btn-ghost:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.7); }
.hero-scroll {
  position: absolute; bottom: 2.5rem; left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: column;
  align-items: center; gap: 0.5rem;
  color: rgba(255,255,255,0.5);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  z-index: 2;
  animation: fadeUp 1s 3s both;
}
.scroll-line {
  width: 1px; height: 60px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%, 100% { transform: scaleY(1); opacity: 0.5; }
  50% { transform: scaleY(0.5); opacity: 1; }
}

/* ─── Marquee ───────────────────────────────── */
.marquee-bar {
  background: var(--dark);
  padding: 1rem 0;
  overflow: hidden;
  white-space: nowrap;
}
.marquee-track {
  display: inline-block;
  animation: marquee 30s linear infinite;
}
.marquee-track span {
  display: inline-block;
  margin: 0 1.5rem;
  font-size: 0.72rem;
  font-weight: 300;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
}
@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ─── Section Common ────────────────────────── */
.section-header { text-align: center; margin-bottom: 3.5rem; }
.section-header.light .section-title { color: #fff; }
.section-header.light .section-eyebrow { color: var(--gold); }
.section-eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--rose);
  margin-bottom: 0.75rem;
}
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  font-weight: 300;
  line-height: 1.15;
  color: var(--dark);
}
.section-title em { font-style: italic; color: var(--rose); }

/* ─── About ─────────────────────────────────── */
.about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  padding: 7rem 4rem;
  max-width: 1280px;
  margin: 0 auto;
  align-items: center;
}
.about-img-wrap {
  position: relative;
  border-radius: var(--radius);
  overflow: visible;
  aspect-ratio: 4/5;
}
.about-img-wrap > img {
  border-radius: var(--radius);
  height: 100%;
  box-shadow: var(--shadow-lg);
}
.about-img-accent {
  position: absolute;
  bottom: -2rem; right: -2.5rem;
  width: 45%; aspect-ratio: 1/1;
  border-radius: var(--radius);
  overflow: hidden;
  border: 6px solid var(--cream);
  box-shadow: var(--shadow);
}
.about-badge {
  position: absolute;
  top: 1.5rem; left: -1.5rem;
  background: var(--rose);
  color: #fff;
  padding: 0.6rem 1.2rem;
  border-radius: 100px;
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  box-shadow: var(--shadow);
}
.about-text .section-eyebrow { text-align: left; }
.about-text .section-title { text-align: left; margin-bottom: 1.5rem; }
.about-text p { margin-bottom: 1rem; }
.about-stats {
  display: flex; gap: 2.5rem;
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(30,26,24,0.1);
}
.stat { display: flex; flex-direction: column; gap: 0.2rem; }
.stat-num {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  font-weight: 600;
  color: var(--rose);
  line-height: 1;
}
.stat span:last-child { font-size: 0.78rem; color: var(--light); letter-spacing: 0.05em; }

/* ─── Gallery ───────────────────────────────── */
.gallery-section { padding: 7rem 4rem; background: var(--ivory); }
.gallery-filters {
  display: flex; gap: 0.75rem;
  justify-content: center;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
}
.filter-btn {
  background: none;
  border: 1px solid rgba(30,26,24,0.2);
  color: var(--mid);
  padding: 0.5rem 1.2rem;
  border-radius: 100px;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 400;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: all 0.3s;
}
.filter-btn.active,
.filter-btn:hover {
  background: var(--rose);
  border-color: var(--rose);
  color: #fff;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 240px;
  gap: 1rem;
  max-width: 1280px;
  margin: 0 auto;
}
.gallery-item {
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
  cursor: pointer;
  transition: opacity 0.4s, transform 0.4s;
}
.gallery-item.tall { grid-row: span 2; }
.gallery-item.wide { grid-column: span 2; }
.gallery-item img { transition: transform 0.6s var(--transition); }
.gallery-item:hover img { transform: scale(1.07); }
.gallery-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(30,26,24,0.7), transparent);
  opacity: 0;
  transition: opacity 0.4s;
  display: flex; align-items: flex-end;
  padding: 1.2rem;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-overlay span {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  color: #fff;
  font-weight: 300;
  font-style: italic;
}

/* ─── Video Section ─────────────────────────── */
.video-section {
  padding: 7rem 4rem;
  background: var(--dark);
}
.videos-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 1.5rem;
  max-width: 1280px;
  margin: 0 auto;
  align-items: start;
}
.video-card { border-radius: var(--radius); overflow: hidden; background: var(--charcoal); }
.video-thumb { position: relative; aspect-ratio: 16/9; }
.video-thumb iframe { width: 100%; height: 100%; border: none; display: block; }
.video-info { padding: 1.5rem; }
.video-tag {
  display: inline-block;
  background: rgba(212,118,138,0.2);
  color: var(--blush);
  padding: 0.2rem 0.7rem;
  border-radius: 100px;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 0.6rem;
}
.video-info h3 {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--ivory);
  margin-bottom: 0.5rem;
}
.video-info p { font-size: 0.85rem; color: var(--light); }
.video-card.featured .video-info h3 { font-size: 1.6rem; }

/* ─── Shop ──────────────────────────────────── */
.shop-section { padding: 7rem 4rem; position: relative; }
.shop-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  max-width: 1280px;
  margin: 0 auto;
}
.shop-card {
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 2px 20px rgba(30,26,24,0.06);
  transition: transform 0.4s, box-shadow 0.4s;
}
.shop-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
.shop-img-wrap {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
}
.shop-img-wrap img { transition: transform 0.6s; }
.shop-card:hover .shop-img-wrap img { transform: scale(1.05); }
.shop-badge {
  position: absolute;
  top: 1rem; left: 1rem;
  background: var(--rose);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
}
.shop-badge.new { background: var(--green); }
.shop-info { padding: 1.5rem; }
.shop-info h3 {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 400;
  margin-bottom: 0.4rem;
  color: var(--dark);
}
.shop-info p { font-size: 0.82rem; margin-bottom: 1.2rem; }
.shop-footer { display: flex; align-items: center; justify-content: space-between; }
.price {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--rose);
}
.btn-cart {
  background: none;
  border: 1px solid var(--rose);
  color: var(--rose);
  padding: 0.45rem 1rem;
  border-radius: 100px;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: all 0.3s;
}
.btn-cart:hover, .btn-cart.added { background: var(--rose); color: #fff; }
.cart-toast {
  position: fixed;
  bottom: 2rem; right: 2rem;
  background: var(--dark);
  color: var(--ivory);
  padding: 1rem 1.5rem;
  border-radius: var(--radius-sm);
  font-size: 0.9rem;
  box-shadow: var(--shadow);
  transform: translateY(120%);
  transition: transform 0.4s var(--transition);
  z-index: 800;
}
.cart-toast.show { transform: translateY(0); }

/* ─── Testimonials ──────────────────────────── */
.testimonials {
  padding: 7rem 4rem;
  background: linear-gradient(135deg, var(--deep-rose), var(--rose));
  position: relative;
  overflow: hidden;
}
.testimonials::before {
  content: '✿';
  position: absolute;
  font-size: 30rem;
  color: rgba(255,255,255,0.04);
  top: -5rem; right: -5rem;
  line-height: 1;
  pointer-events: none;
}
.testi-track {
  display: flex;
  justify-content: center;
  position: relative;
  max-width: 640px;
  margin: 0 auto;
  min-height: 260px;
}
.testi-card {
  position: absolute;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--radius);
  padding: 2.5rem;
  width: 100%;
  opacity: 0;
  transform: scale(0.95);
  transition: opacity 0.5s, transform 0.5s;
  pointer-events: none;
}
.testi-card.active {
  opacity: 1;
  transform: scale(1);
  pointer-events: all;
}
.testi-stars { color: var(--gold); font-size: 1rem; margin-bottom: 1rem; letter-spacing: 0.1em; }
.testi-card p { color: rgba(255,255,255,0.9); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.5rem; }
.testi-author {
  display: flex; align-items: center; gap: 1rem;
}
.testi-author img {
  width: 48px; height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(255,255,255,0.3);
}
.testi-author strong { color: #fff; display: block; font-size: 0.9rem; }
.testi-author span { color: rgba(255,255,255,0.6); font-size: 0.78rem; }
.testi-dots {
  display: flex; gap: 0.5rem;
  justify-content: center;
  margin-top: 2rem;
  position: relative;
  z-index: 2;
}
.dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.3);
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
}
.dot.active { background: #fff; transform: scale(1.3); }

/* ─── Contact ───────────────────────────────── */
.contact-section {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 5rem;
  padding: 7rem 4rem;
  max-width: 1280px;
  margin: 0 auto;
  align-items: center;
}
.contact-left .section-eyebrow,
.contact-left .section-title { text-align: left; }
.contact-left p { margin: 1rem 0 2rem; }
.contact-details { display: flex; flex-direction: column; gap: 1.2rem; }
.contact-item { display: flex; gap: 1rem; align-items: flex-start; }
.contact-icon {
  font-size: 1.2rem;
  color: var(--rose);
  line-height: 1.4;
  flex-shrink: 0;
}
.contact-item strong { display: block; font-size: 0.85rem; color: var(--dark); letter-spacing: 0.05em; }
.contact-item p { font-size: 0.85rem; margin: 0; }

/* Form */
.contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-group label {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--mid);
}
.form-group input,
.form-group select,
.form-group textarea {
  padding: 0.85rem 1rem;
  border: 1px solid rgba(30,26,24,0.15);
  border-radius: var(--radius-sm);
  background: var(--ivory);
  font-family: var(--font-sans);
  font-size: 0.9rem;
  color: var(--dark);
  transition: border-color 0.3s, box-shadow 0.3s;
  outline: none;
  resize: vertical;
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--rose);
  box-shadow: 0 0 0 3px rgba(212,118,138,0.15);
}
.form-success {
  color: var(--green);
  font-size: 0.9rem;
  text-align: center;
  opacity: 0;
  height: 0;
  overflow: hidden;
  transition: opacity 0.3s, height 0.3s;
}
.form-success.show { opacity: 1; height: auto; }

/* ─── Footer ────────────────────────────────── */
.footer { background: var(--dark); color: var(--ivory); }
.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 3rem;
  padding: 5rem 4rem 3rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.footer-logo {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  font-weight: 400;
  color: var(--ivory);
  margin-bottom: 1rem;
}
.footer-brand p { font-size: 0.85rem; color: rgba(255,255,255,0.5); line-height: 1.7; margin-bottom: 1.5rem; }
.footer-socials { display: flex; gap: 0.75rem; }
.footer-socials a {
  width: 36px; height: 36px;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50%;
  display: grid; place-items: center;
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  transition: border-color 0.3s, color 0.3s, background 0.3s;
}
.footer-socials a:hover { background: var(--rose); border-color: var(--rose); color: #fff; }
.footer-links { display: flex; flex-direction: column; gap: 0.7rem; }
.footer-links h4 {
  font-size: 0.72rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.5rem;
}
.footer-links a { font-size: 0.85rem; color: rgba(255,255,255,0.5); transition: color 0.3s; }
.footer-links a:hover { color: var(--ivory); }
.footer-newsletter h4 {
  font-size: 0.72rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.5rem;
}
.footer-newsletter p { font-size: 0.85rem; color: rgba(255,255,255,0.5); margin-bottom: 1rem; }
.newsletter-form {
  display: flex;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 100px;
  overflow: hidden;
}
.newsletter-form input {
  flex: 1;
  background: none;
  border: none;
  padding: 0.7rem 1.2rem;
  font-size: 0.85rem;
  color: var(--ivory);
  font-family: var(--font-sans);
  outline: none;
}
.newsletter-form input::placeholder { color: rgba(255,255,255,0.3); }
.newsletter-form button {
  background: var(--rose);
  border: none;
  padding: 0 1.2rem;
  color: #fff;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.3s;
}
.newsletter-form button:hover { background: var(--deep-rose); }
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 4rem;
}
.footer-bottom p { font-size: 0.78rem; color: rgba(255,255,255,0.3); }
.footer-legal { display: flex; gap: 1.5rem; }
.footer-legal a { font-size: 0.78rem; color: rgba(255,255,255,0.3); transition: color 0.3s; }
.footer-legal a:hover { color: var(--ivory); }

/* ─── Scroll Reveal ─────────────────────────── */
.reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s, transform 0.7s; }
.reveal.visible { opacity: 1; transform: none; }

/* ─── Responsive ────────────────────────────── */
@media (max-width: 1024px) {
  .nav { padding: 1.2rem 2rem; }
  .nav.scrolled { padding: 0.8rem 2rem; }
  .nav-links { display: none; }
  .nav-cta { display: none; }
  .hamburger { display: flex; }
  .hero-content { padding: 0 2rem; }
  .about { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 2rem; }
  .about-img-wrap { max-width: 480px; margin: 0 auto; aspect-ratio: 4/3; }
  .gallery-section { padding: 5rem 2rem; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-item.wide { grid-column: span 2; }
  .videos-grid { grid-template-columns: 1fr; max-width: 600px; }
  .shop-grid { grid-template-columns: repeat(2, 1fr); }
  .shop-section { padding: 5rem 2rem; }
  .contact-section { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 2rem; }
  .footer-top { grid-template-columns: 1fr 1fr; gap: 2rem; padding: 4rem 2rem 2rem; }
  .footer-bottom { flex-direction: column; gap: 0.75rem; padding: 1.5rem 2rem; text-align: center; }
  .video-section { padding: 5rem 2rem; }
  .testimonials { padding: 5rem 2rem; }
}

@media (max-width: 640px) {
  .hero-title { font-size: 2.8rem; }
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-item.wide, .gallery-item.tall { grid-column: span 1; grid-row: span 1; }
  .shop-grid { grid-template-columns: 1fr; max-width: 360px; margin: 0 auto; }
  .form-row { grid-template-columns: 1fr; }
  .footer-top { grid-template-columns: 1fr; }
  .about-stats { flex-wrap: wrap; gap: 1.5rem; }
  .cursor, .cursor-dot { display: none; }
  body { cursor: auto; }
}
